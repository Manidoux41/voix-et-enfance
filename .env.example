# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Voix & Enfance"

# Supabase - ne jamais exposer la service role key au navigateur
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Email transactionnel (Brevo) : adresse seule, sans nom ni chevrons
BREVO_API_KEY=
EMAIL_FROM=signature@votre-domaine.fr

# Securite OTP : generer avec node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Conserver la meme valeur dans tous les environnements d'une meme collecte.
OTP_HASH_SECRET=

# Administration (a remplacer par Supabase Auth avant ouverture publique)
ADMIN_ACCESS_TOKEN=
